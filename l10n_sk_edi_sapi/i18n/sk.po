#. module: l10n_sk_edi_sapi
#: model:ir.model.fields,help:l10n_sk_edi_sapi.field_res_company__l10n_sk_sapi_provider
#: model:ir.model.fields,help:l10n_sk_edi_sapi.field_res_config_settings__l10n_sk_sapi_provider
